# Eventio Environment Configuration Example

# API Server Configuration
PORT=8080

# Environment mode
# Use "development" locally and "production" in deployed environments.
APP_ENV=development

# Database Configuration
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=<sslmode>
DATABASE_URL=postgres://postgres:postgres@db:5432/eventio?sslmode=disable

# Required by the Postgres Docker image to initialize the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventio

# Backend Security Configuration
# Required: backend fails fast if JWT_SECRET is missing
JWT_SECRET=CHANGE_ME

# Reverse Proxy Trust Configuration
# Comma-separated proxy CIDRs/IPs that are allowed to set X-Forwarded-For.
#
# Development (Docker local): keep empty unless you intentionally test behind a proxy.
TRUSTED_PROXIES=
#
# Production examples (set to your actual infrastructure ranges):
# TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
# TRUSTED_PROXIES=203.0.113.10/32

# Payment Configuration
# Local dev default: use the mock gateway so checkout flows work immediately.
# The mock gateway is blocked automatically when APP_ENV=production.
ACTIVE_PAYMENT_GATEWAY=mock
PAYMENT_CURRENCY=INR
#
# Production Razorpay configuration:
# ACTIVE_PAYMENT_GATEWAY=razorpay
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
# RAZORPAY_SECRET=replace-with-razorpay-secret
# RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
# Optional non-production override for local gateway stubs:
# RAZORPAY_BASE_URL=https://api.razorpay.com
#
# Optional host-side integration-test override if you run Go tests outside Docker:
# TEST_DATABASE_URL=host=localhost user=postgres password=postgres dbname=eventio_test port=5432 sslmode=disable

# Frontend Configuration (If any specific env vars are needed later)
# PUBLIC_API_URL=http://localhost:8080
