# Eventio Environment Configuration Example

# API Server Configuration
PORT=8080

# Database Configuration
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=<sslmode>
DATABASE_URL=postgres://postgres:postgres@db:5432/eventio?sslmode=disable

# Required by the Postgres Docker image to initialize the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventio

# Frontend Configuration (If any specific env vars are needed later)
# PUBLIC_API_URL=http://localhost:8080
